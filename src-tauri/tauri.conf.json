{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pi Usage Monitor",
  "version": "0.1.0",
  "identifier": "dev.pi.usage-report",
  "build": {
    "beforeDevCommand": "npm --prefix src-tauri/src-web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix src-tauri/src-web run build",
    "frontendDist": "web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pi Agent · Token Monitor",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "externalBin": [],
    "resources": []
  }
}
