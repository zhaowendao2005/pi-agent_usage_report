{
  "name": "usage-report",
  "version": "0.1.0",
  "description": "Pi extension: multi-instance token/cost/TTFT usage collector + Tauri dashboard",
  "type": "module",
  "license": "MIT",
  "keywords": ["pi-package", "pi-extension", "usage", "token", "cost", "tauri"],
  "files": [
    "dist/extensions",
    "dist/BUILD_INFO.json",
    "dist/pi-usage-monitor.exe",
    "README.md"
  ],
  "pi": {
    "extensions": ["./dist/extensions"]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:web": "npm --prefix src-tauri/src-web run build",
    "dev": "npx tauri dev",
    "seed": "node scripts/seed-db.mjs",
    "calibrate": "node scripts/calibrate-existing-db.mjs",
    "release": "node scripts/release.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.0.0",
    "typebox": "*",
    "typescript": "^5.5.0"
  }
}
